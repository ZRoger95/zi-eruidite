---
import MetaPost from "@/components/MetaPost.astro"
import PostActions from "@/components/PostActions.astro"
import PostChain from "@/components/PostChain.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SeriesReader from "@/components/SeriesReader.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import {
  getPostViews,
  getPosts,
  getSubpostViews,
  getSubposts,
} from "@/lib/content"
import { isSubpost, subpostSlug } from "@/lib/utils"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const posts = await getPosts()
  const series = await getSubposts()
  return posts.flatMap((parent, i) => {
    const chain = [parent, ...(series.get(parent.id) ?? [])]
    return chain.map((post) => ({
      params: { id: post.id },
      props: { post, chain, prev: posts[i + 1], next: posts[i - 1] },
    }))
  })
}

type Props = {
  post: CollectionEntry<"blog">
  chain: CollectionEntry<"blog">[]
  prev?: CollectionEntry<"blog">
  next?: CollectionEntry<"blog">
}

const { post, chain, prev, next } = Astro.props
const [parent] = chain

// 仅当当前 URL 节点存在非 draft 英文译文时输出 hreflang 配对
const parentId = post.id.split("/")[0]
const views = isSubpost(post.id)
  ? ((await getSubpostViews("zh")).get(parentId) ?? [])
  : await getPostViews("zh")
const view = views.find((item) => item.id === post.id)
const alternates = view?.translated
  ? { zh: `/blog/${post.id}`, en: `/en/blog/${post.id}` }
  : undefined

const rendered = await Promise.all(
  chain.map(async (entry) => ({
    entry,
    ...(await render(entry)),
    authors: await getEntries(entry.data.authors),
  })),
)

const items = rendered.map(({ entry, Content, authors }) => ({
  view: { id: entry.id, data: entry.data, translated: true, zh: entry },
  Content,
  authors,
}))

const sections = rendered.map(({ entry, headings }, i) => ({
  id: i === 0 ? undefined : subpostSlug(entry.id),
  label: entry.data.title,
  open: entry.id === post.id,
  headings: headings.filter(
    ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
  ),
}))
const hasToc =
  sections.length > 1 || sections.some(({ headings }) => headings.length > 0)

const crumbs = [{ label: parent.data.title, href: `/blog/${parent.id}` }]
if (isSubpost(post.id)) {
  crumbs.push({ label: post.data.title, href: `/blog/${post.id}` })
}
---

<Layout crumbs={crumbs} article>
  <MetaPost
    slot="head"
    post={post}
    canonical={isSubpost(post.id) ? `/blog/${parent.id}` : undefined}
    alternates={alternates}
  />
  {hasToc && (
    <TableOfContents slot="toc" title={parent.data.title} sections={sections} />
  )}
  <PostActions slot="actions" prev={prev} next={next} />
  <ScrollToTop floating />
  <PostChain locale="zh" currentId={post.id} items={items} />
  {chain.length > 1 && <SeriesReader />}
</Layout>
