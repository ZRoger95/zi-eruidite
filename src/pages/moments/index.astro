---
import ActivityGraph from "@/components/ActivityGraph.astro"
import HairlineFigure from "@/components/HairlineFigure.astro"
import MomentCard from "@/components/MomentCard.astro"
import MomentComposer from "@/components/MomentComposer.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getMoments } from "@/lib/content"

const PAGE_SIZE = 20
const allMoments = await getMoments()

// Get page number from URL query param (?page=2) or first page
const currentPage = Number(Astro.url.searchParams.get("page") || 1)
const totalPages = Math.max(1, Math.ceil(allMoments.length / PAGE_SIZE))
const start = (currentPage - 1) * PAGE_SIZE
const moments = allMoments.slice(start, start + PAGE_SIZE)

function pageUrl(p: number): string {
  return p === 1 ? "/moments" : `/moments?page=${p}`
}
---

<Layout>
  <MetaPage slot="head" title="动态" description="短动态、闪念与随手记录。" />
  <div class="timeline-page">
    <header class="timeline-head">
      <div class="timeline-head-text">
        <p class="timeline-kicker">~/moments · {allMoments.length} entries</p>
        <h1 class="timeline-title">动态</h1>
        <p class="timeline-desc">短动态、闪念与随手记录。</p>
      </div>
      <div class="timeline-head-figure">
        <HairlineFigure
          figure="riffle"
          label="一排动态卡片，指针经过时卡片会依次立起"
          width="176px"
          play
        />
      </div>
    </header>
    <ActivityGraph moments={allMoments} />
    <MomentComposer />
    <div class="timeline">
      {moments.map((moment) => (
        <div class="tl-entry">
          <span class="tl-node" aria-hidden="true"></span>
          <MomentCard moment={moment} variant="zed" />
        </div>
      ))}
      {moments.length === 0 && (
        <div class="timeline-empty">
          <HairlineFigure
            figure="sieve"
            label="一只空筛子"
            width="200px"
            play
          />
          <p class="empty">还没有动态。</p>
        </div>
      )}
    </div>
    {totalPages > 1 && (
      <nav class="pagination">
        {currentPage > 1 && (
          <a href={pageUrl(currentPage - 1)}>← 上一页</a>
        )}
        <span>{currentPage} / {totalPages}</span>
        {currentPage < totalPages && (
          <a href={pageUrl(currentPage + 1)}>下一页 →</a>
        )}
      </nav>
    )}
  </div>
</Layout>

<style>
  .timeline-page {
    max-width: 720px;
    margin-inline: auto;
  }

  .timeline-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--border);
  }

  .timeline-head-text {
    min-width: 0;
  }

  .timeline-head-figure {
    flex-shrink: 0;
    line-height: 0;
    /* 宿主盒按 5:4 留了大量内边距，墨迹实际居中在盒内；下推让墨迹与文字块同高 */
    margin-bottom: -33px;
    /* 再上提墨迹的光学中心：不改变页头高度，也不让它压上分隔线 */
    transform: translateY(-11px);
  }

  .timeline-desc {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  .timeline-kicker {
    font-family: var(--font-mono);
    font-size: calc(var(--step--1) - 1px);
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-3xs);
  }

  .timeline-title {
    font-size: var(--step-3);
    font-weight: 610;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--accent);
    margin: 0;
  }

  .timeline {
    position: relative;
    padding-left: 28px;
  }

  /* Zed 实线时间轴脊柱 */
  .timeline::before {
    content: "";
    position: absolute;
    left: 9px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--border);
  }

  .tl-entry {
    position: relative;
    padding-bottom: var(--space-l);
  }

  .tl-entry:last-child {
    padding-bottom: 0;
  }

  /* 菱形节点，居中骑在脊柱上，与条目日期行对齐 */
  .tl-node {
    position: absolute;
    left: -22.5px;
    top: 4px;
    width: 8px;
    height: 8px;
    transform: rotate(45deg);
    background: var(--background);
    border: 1px solid var(--accent);
  }

  .timeline-empty {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    padding: var(--space-l) 0;
  }

  .empty {
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin: 0;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: calc(var(--step--1) - 1px);

    a,
    span {
      color: var(--muted-foreground);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: var(--space-3xs) var(--space-xs);
    }

    span {
      border-color: transparent;
    }

    a {
      color: var(--foreground);
      text-decoration: none;
      transition:
        border-color 0.15s ease,
        color 0.15s ease;
    }

    a:hover {
      color: var(--accent);
      border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    }
  }

  @media (width < 640px) {
    /* 窄屏留给阅读栏，插图只在宽屏出现 */
    .timeline-head-figure {
      display: none;
    }
  }

  @media (width < 480px) {
    .timeline {
      padding-left: 20px;
    }

    .timeline::before {
      left: 5px;
    }

    .tl-node {
      left: -18.5px;
    }
  }
</style>
