---
import MomentCard from "@/components/MomentCard.astro"
import Layout from "@/layouts/Layout.astro"
import { getMoments, pageTitle } from "@/lib/content"
import { getEntry, type CollectionEntry } from "astro:content"
import { SITE } from "@/consts"
import { localeFromPath, SITE_META, t } from "@/lib/i18n"

export async function getStaticPaths() {
  const moments = await getMoments()
  return moments.map((moment) => ({
    params: { id: moment.id },
    props: { moment },
  }))
}

type Props = { moment: CollectionEntry<"moments"> }

const { moment } = Astro.props
const locale = localeFromPath(Astro.url.pathname)

const dateStr = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Shanghai",
}).format(moment.data.date)

const base = Astro.site ?? new URL(Astro.url.origin)
const canonical = new URL(Astro.url.pathname, base)
const ogImage = new URL(SITE.defaultPageImage, base)

// Extract first text paragraph (non-image, non-heading) as description
const { body } = moment
const descMatch = body?.match(/^(?!#)(?!!\[)(.+)$/m)
const description = descMatch
  ? descMatch[1].trim().slice(0, 155)
  : `动态 · ${dateStr}`
---

<Layout>
  <Fragment slot="head">
    <title>{pageTitle(`动态 · ${dateStr}`)}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta property="og:title" content={`动态 · ${dateStr}`}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="article">
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content={SITE.title}>
    <meta property="og:locale" content={SITE_META[locale].ogLocale}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:alt" content={`动态 · ${dateStr}`}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={`动态 · ${dateStr}`}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={`动态 · ${dateStr}`}>
    <meta
      property="article:published_time"
      content={moment.data.date.toISOString()}
    >
  </Fragment>

  <div class="moment-detail">
    <p class="article-kicker">~/moments · {moment.id}</p>
    <MomentCard moment={moment} link={false} variant="article" />
    <nav class="back-nav">
      <a href="/moments">← {t(locale, "backToMoments")}</a>
    </nav>
  </div>
</Layout>

<style>
  .moment-detail {
    max-width: 44rem;
  }

  .article-kicker {
    font-family: var(--font-mono);
    font-size: calc(var(--step--1) - 1px);
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-s);
  }

  .back-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);

    a {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: calc(var(--step--1) - 1px);
      color: var(--foreground);
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: var(--space-3xs) var(--space-xs);
      transition:
        border-color 0.15s,
        color 0.15s;
    }

    a:hover {
      color: var(--accent);
      border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    }
  }
</style>
