---
import ListingHead from "@/components/ListingHead.astro"
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPostViews, getPosts } from "@/lib/content"
import { t } from "@/lib/i18n"
import { getCollection, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const authors = await getCollection("authors")
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author },
  }))
}

type Props = { author: CollectionEntry<"authors"> }

const { author } = Astro.props
const { name, bio, avatar } = author.data

const posts = (await getPosts()).filter((post) =>
  post.data.authors.some((ref) => ref.id === author.id),
)
const listed = new Set(posts.map((post) => post.id))

// 英文译作：en 条目署名该作者、且中文侧未列（同一作品不重复；中文已署名
// 时优先链中文原文）。卡片按 en 数据渲染、链接指向 /en/blog/<id>。
const translations = (await getPostViews("en")).filter(
  (view) =>
    view.translated &&
    !listed.has(view.id) &&
    view.en?.data.authors.some((ref) => ref.id === author.id),
)

// 两类条目按日期倒序合并为一个列表（日期取中文侧，与既有排序一致）。
const entries = [
  ...posts.map((post) => ({ date: post.data.date, post })),
  ...translations.map((view) => ({ date: view.zh.data.date, view })),
].sort((a, b) => b.date.getTime() - a.date.getTime())
---

<Layout>
  <MetaPage slot="head" title={`${name}（作者）`} description={bio} noindex />
  <div class="author-head">
    <img src={avatar} alt={name} width="64" height="64">
    <ListingHead
      kicker={`~/authors/${author.id} · ${entries.length} entries`}
      title={name}
      desc={bio ?? undefined}
    />
  </div>

  <section>
    <h2>文章</h2>
    {entries.length > 0 ? (
        <ul>
          {entries.map((item) =>
            "view" in item ? (
              <BlogCard
                post={item.view}
                locale="en"
                badge={
                  item.view.en?.data.aiTranslated
                    ? t("zh", "aiTranslated")
                    : undefined
                }
              />
            ) : (
              <BlogCard post={item.post} />
            ),
          )}
        </ul>
      ) : (
        <p>暂无文章。</p>
      )}
  </section>
</Layout>

<style>
  .author-head {
    position: relative;
    /* 头像坐在分隔线上会一直伸到线下，给分隔线与「文章」留些呼吸 */
    margin-block-end: var(--space-2xs);
    /* 左侧留出头像列（64px + 间隙），负 margin 把整块拉回内容左缘 */
    margin-inline-start: calc(-1 * (var(--space-s) + 64px));
    padding-inline-start: calc(var(--space-s) + 64px);

    img {
      position: absolute;
      inset-inline-start: 0;
      /* 与作者名光学对齐：头像顶边下移「h1 行盒中心距容器顶 − 半像高」，
         即 kicker 高 + 半行盒 − 32px；两端实测 328px→3.8px、1215px→10.3px，
         线性拟合为 1.94px + 0.69vw */
      inset-block-start: clamp(3.8px, 1.94px + 0.69vw, 10.3px);
      border-radius: var(--radius-full);
    }

    :global(.listing-head) {
      margin-bottom: 0;
    }
  }

  section {
    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    > p {
      color: var(--muted-foreground);
    }
  }

  @media (width < 52rem) {
    /* 窄屏的页面内边距放不进 80px 的头像列（负 margin 会把头像推出
       视口），改回正常流堆叠在页头上方，同 AuthorCard 窄屏行为 */
    .author-head {
      margin-inline-start: 0;
      padding-inline-start: 0;

      img {
        position: static;
        margin-block-end: var(--space-xs);
      }
    }
  }
</style>
