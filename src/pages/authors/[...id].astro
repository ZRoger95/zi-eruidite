---
import AuthorCard from "@/components/AuthorCard.astro"
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPostViews, getPosts } from "@/lib/content"
import { t } from "@/lib/i18n"
import { getCollection, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const authors = await getCollection("authors")
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author },
  }))
}

type Props = { author: CollectionEntry<"authors"> }

const { author } = Astro.props
const { name, bio } = author.data

const posts = (await getPosts()).filter((post) =>
  post.data.authors.some((ref) => ref.id === author.id),
)
const listed = new Set(posts.map((post) => post.id))

// 英文译作：en 条目署名该作者、且中文侧未列（同一作品不重复；中文已署名
// 时优先链中文原文）。卡片按 en 数据渲染、链接指向 /en/blog/<id>。
const translations = (await getPostViews("en")).filter(
  (view) =>
    view.translated &&
    !listed.has(view.id) &&
    view.en?.data.authors.some((ref) => ref.id === author.id),
)

// 两类条目按日期倒序合并为一个列表（日期取中文侧，与既有排序一致）。
const entries = [
  ...posts.map((post) => ({ date: post.data.date, post })),
  ...translations.map((view) => ({ date: view.zh.data.date, view })),
].sort((a, b) => b.date.getTime() - a.date.getTime())
---

<Layout crumbs={[{ label: name, href: `/authors/${author.id}` }]}>
  <MetaPage slot="head" title={`${name}（作者）`} description={bio} noindex />
  <header>
    <ul>
      <AuthorCard author={author} />
    </ul>
  </header>

  <section>
    <h2>文章</h2>
    {entries.length > 0 ? (
        <ul>
          {entries.map((item) =>
            "view" in item ? (
              <BlogCard
                post={item.view}
                locale="en"
                badge={
                  item.view.en?.data.aiTranslated
                    ? t("zh", "aiTranslated")
                    : undefined
                }
              />
            ) : (
              <BlogCard post={item.post} />
            ),
          )}
        </ul>
      ) : (
        <p>暂无文章。</p>
      )}
  </section>
</Layout>

<style>
  header {
    margin-block-end: var(--space-l);
  }

  section {
    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    > p {
      color: var(--muted-foreground);
    }
  }
</style>
