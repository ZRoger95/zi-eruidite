---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE } from "@/consts"
import { getPosts } from "@/lib/content"

const posts = await getPosts()
const latestPosts = posts.slice(0, 5)
---

<Layout>
  <MetaPage slot="head" />

  <hero-card>
    {SITE.avatar && (
      <hero-avatar>
        <img src={SITE.avatar} alt={`${SITE.title} avatar`} width="64" height="64" />
      </hero-avatar>
    )}
    <h1>Hi! I'm {SITE.title}</h1>
    <p>
      astro-erudite is
      <a href="https://enscribe.dev" target="_blank" rel="noopener noreferrer"
        >enscribe</a
      >'s opinionated, unstyled static blogging template built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
        >Astro</a
      >
      and native CSS. astro-erudite uses no UI or CSS framework and contains
      minimal dependencies.
    </p>
    <p>
      To use this template, check out the
      <a
        href="https://github.com/jktrn/astro-erudite"
        target="_blank"
        rel="noopener noreferrer"
        >GitHub</a
      >
      repository. To learn more about why this template exists, read this blog
      post: <a href="/blog/introducing-v2">Introducing astro-erudite v2</a>.
    </p>
  </hero-card>

  <latest-section>
    <h2>Latest posts</h2>
    <ul>
      {latestPosts.map((post) => <BlogCard post={post} />)}
    </ul>
  </latest-section>
</Layout>
