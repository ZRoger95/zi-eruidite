---
import BlogCard from "@/components/BlogCard.astro"
import MomentCard from "@/components/MomentCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE } from "@/consts"
import { getMoments, getPosts } from "@/lib/content"

const posts = await getPosts()
const latestPosts = posts.slice(0, 5)
const moments = SITE.momentsOnHome
  ? (await getMoments()).slice(0, SITE.momentsOnHome.count)
  : []
---

<Layout>
  <MetaPage slot="head" />

  <hero-card>
    {SITE.avatar && (
      <hero-avatar>
        <img src={SITE.avatar} alt={`${SITE.title} avatar`} width="64" height="64" />
      </hero-avatar>
    )}
    <h1>Hi! I'm {SITE.title}</h1>
    <p>
      astro-erudite is
      <a href="https://enscribe.dev" target="_blank" rel="noopener noreferrer"
        >enscribe</a
      >'s opinionated, unstyled static blogging template built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
        >Astro</a
      >
      and native CSS. astro-erudite uses no UI or CSS framework and contains
      minimal dependencies.
    </p>
    <p>
      To use this template, check out the
      <a
        href="https://github.com/jktrn/astro-erudite"
        target="_blank"
        rel="noopener noreferrer"
        >GitHub</a
      >
      repository. To learn more about why this template exists, read this blog
      post: <a href="/blog/introducing-v2">Introducing astro-erudite v2</a>.
    </p>
  </hero-card>

  <latest-section>
    <h2>Latest posts</h2>
    <ul>
      {latestPosts.map((post) => <BlogCard post={post} />)}
    </ul>
  </latest-section>

  {moments.length > 0 && (
    <latest-section>
      <h2>
        最新动态
        <a href="/moments" class="see-all">查看全部 →</a>
      </h2>
      <div class="moments-list">
        {moments.map((moment) => (
          <a
            href={`/moments/${moment.id}`}
            class="moment-home-link"
          >
            <MomentCard moment={moment} />
          </a>
        ))}
      </div>
    </latest-section>
  )}
</Layout>

<style>
  .see-all {
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted-foreground);
    text-decoration: none;
    margin-left: var(--space-s);
    transition: color 0.15s;
  }

  .see-all:hover {
    color: var(--accent);
  }

  .moments-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .moment-home-link {
    text-decoration: none;
    color: inherit;
  }
</style>
