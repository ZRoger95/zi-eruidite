---
import ListingHead from "@/components/ListingHead.astro"
import MetaPage from "@/components/MetaPage.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import Layout from "@/layouts/Layout.astro"
import { t } from "@/lib/i18n"
import { getCollection } from "astro:content"

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0),
)
---

<Layout>
  <MetaPage slot="head" title={t("zh", "projectsTitle")} />
  <ListingHead
    kicker={`~/projects · ${projects.length} projects`}
    title={t("zh", "projectsTitle")}
    desc={t("zh", "projectsDesc")}
    figure="settle"
    figureLabel="十二块瓷砖散落在 hub 周围，指针靠近时滑正成一棵树"
  />
  <ul>
    {projects.map((project) => <ProjectCard project={project} />)}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
