---
import BlogCard from "@/components/BlogCard.astro"
import HairlineFigure from "@/components/HairlineFigure.astro"
import MomentCard from "@/components/MomentCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getAllTags } from "@/lib/content"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const tags = await getAllTags()
  return [...tags].map(([tag, { blog, moments }]) => ({
    params: { id: tag },
    props: { tag, blog, moments },
  }))
}

type Props = {
  tag: string
  blog: CollectionEntry<"blog">[]
  moments: CollectionEntry<"moments">[]
}

const { tag, blog, moments } = Astro.props

const allItems = [
  ...blog.map((p) => ({ type: "blog" as const, date: p.data.date, entry: p })),
  ...moments.map((m) => ({
    type: "moment" as const,
    date: m.data.date,
    entry: m,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime())
---

<Layout
  crumbs={[
    { label: "标签", href: "/tags" },
    { label: `#${tag}`, href: `/tags/${tag}` },
  ]}
>
  <MetaPage
    slot="head"
    title={`#${tag}`}
    description={`标注为 #${tag} 的内容。`}
    noindex
  />
  <header class="tags-head">
    <div class="tags-head-text">
      <p class="tags-kicker">~/tags · #{tag}</p>
      <h1 class="tags-title">#{tag}</h1>
      <p class="tags-desc">标注为 #{tag} 的内容。</p>
    </div>
    <div class="tags-head-figure">
      <HairlineFigure
        figure="phosphor"
        label="七乘七余辉点阵，像散落的标签，指针划过时依次亮起"
        width="176px"
        play
      />
    </div>
  </header>
  <div class="tag-page">
    {allItems.length === 0 && <p class="empty">暂无标注 #{tag} 的内容。</p>}
    {allItems.map((item) =>
      item.type === "blog" ? (
        <BlogCard post={item.entry as CollectionEntry<"blog">} />
      ) : (
        <MomentCard moment={item.entry as CollectionEntry<"moments">} />
      ),
    )}
  </div>
</Layout>

<style>
  .tags-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--border);
  }

  .tags-head-text {
    min-width: 0;
  }

  .tags-head-figure {
    flex-shrink: 0;
    line-height: 0;
    /* 与 index 页头一致：phosphor 墨迹中心比文字块高约 16px，下移居中 */
    margin-bottom: -18px;
    transform: translateY(10px);
  }

  .tags-kicker {
    font-family: var(--font-mono);
    font-size: calc(var(--step--1) - 1px);
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    margin: 0 0 var(--space-3xs);
  }

  .tags-title {
    font-size: var(--step-3);
    font-weight: 610;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--accent);
    margin: 0;
  }

  .tags-desc {
    margin: var(--space-2xs) 0 0;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  .tag-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 640px;
  }

  .empty {
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  @media (width < 640px) {
    /* 窄屏留给阅读栏，插图只在宽屏出现 */
    .tags-head-figure {
      display: none;
    }
  }
</style>
