---
import {
  localeFromPath,
  localePath,
  SITE_META,
  stripLocalePath,
  t,
} from "@/lib/i18n"
import { normalizePath } from "@/lib/utils"

const pathname = normalizePath(Astro.url.pathname) || "/"
const locale = localeFromPath(pathname)
const stripped = stripLocalePath(pathname)

// Only pages with a bilingual twin get a switcher (home & blog);
// zh-only sections (moments, projects, authors, tags) render nothing.
const hasEnglishTwin =
  stripped === "/" || stripped === "/blog" || stripped.startsWith("/blog/")
if (!hasEnglishTwin) return

const target = locale === "zh" ? "en" : "zh"
const href = locale === "zh" ? localePath(stripped, "en") : stripped
---

<a
  data-language-switch
  href={href}
  lang={SITE_META[target].htmlLang}
  aria-label={t(locale, "langSwitchAria")}
  >{t(locale, "langSwitch")}</a
>

<style>
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding-inline: var(--space-3xs);
    border-radius: var(--radius-md);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-decoration-line: none;

    &:hover {
      color: var(--foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
    }
  }
</style>
