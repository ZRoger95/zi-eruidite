---
import Logo from "@/assets/logo.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

const pathname = normalizePath(Astro.url.pathname) || "/"
const isTopbar = SITE.layout === "topbar"
---

<header data-topbar>
  <topbar-inner>
    <topbar-brand>
      <a href="/" aria-label={SITE.title}>
        <Logo />
        <span>{SITE.title}</span>
      </a>
    </topbar-brand>
    <nav>
      <ul>
        {NAVIGATION.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <topbar-actions>
      <ThemeToggle />
      <slot name="actions" />
    </topbar-actions>
  </topbar-inner>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(var(--blur-sm));
    border-block-end: 1px solid
      color-mix(in oklab, var(--border) 60%, transparent);
  }

  topbar-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: var(--grid-max-width);
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block: var(--space-2xs);

    @media (width < 40rem) {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-xs);
    }
  }

  topbar-brand a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--font-weight-medium);
    font-size: var(--step-0);
    color: var(--foreground);
    text-decoration-line: none;

    svg {
      inline-size: 1rem;
      block-size: 1rem;
      flex-shrink: 0;
    }

    span {
      display: none;
    }
  }

  nav {
    justify-self: center;

    @media (width < 40rem) {
      justify-self: end;
    }
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    list-style: none;

    a {
      color: var(--muted-foreground);
      font-size: var(--step--1);
      text-decoration-line: none;

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }
  }

  topbar-actions {
    display: flex;
    align-items: center;
    justify-self: end;
  }
</style>
