---
import Logo from "@/assets/logo.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

const pathname = normalizePath(Astro.url.pathname) || "/"
const isArticle = pathname.startsWith("/blog/") && pathname !== "/blog/"
---

<header data-topbar>
  <topbar-inner>
    <topbar-brand>
      <a href="/" aria-label={SITE.title}>
        <Logo />
        <span>{SITE.title}</span>
      </a>
    </topbar-brand>
    <nav>
      <ul>
        {NAVIGATION.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <topbar-actions>
      <ThemeToggle />
      {isArticle && (
        <button
          id="fullwidth-toggle"
          aria-label="Toggle full width"
          title="Toggle full width"
        >
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline class="expand" points="10,2 14,2 14,6" />
            <polyline class="expand" points="6,14 2,14 2,10" />
            <polyline class="collapse" points="14,10 14,14 10,14" />
            <polyline class="collapse" points="2,6 2,2 6,2" />
          </svg>
        </button>
      )}
      <slot name="actions" />
    </topbar-actions>
  </topbar-inner>
</header>

<script>
  const header = document.querySelector("[data-topbar]")
  if (header) {
    const sentinel = document.createElement("div")
    sentinel.style.cssText =
      "position:absolute;top:0;left:0;width:100%;height:1px;pointer-events:none"
    header.insertAdjacentElement("afterend", sentinel)

    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle("is-scrolled", !entry.isIntersecting)
      },
      { rootMargin: "1px 0px 0px 0px" },
    )
    observer.observe(sentinel)
  }

  // Full-width toggle
  const FULLWIDTH_KEY = "topbar-fullwidth"
  const toggle = document.getElementById("fullwidth-toggle")
  if (toggle) {
    const apply = (on: boolean) => {
      document.documentElement.toggleAttribute("data-fullwidth", on)
      toggle.classList.toggle("is-active", on)
    }
    // Restore saved preference
    apply(localStorage.getItem(FULLWIDTH_KEY) === "true")

    toggle.addEventListener("click", () => {
      const next = !document.documentElement.hasAttribute("data-fullwidth")
      apply(next)
      localStorage.setItem(FULLWIDTH_KEY, String(next))
    })
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(var(--blur-sm));
    transition: border-color 0.2s;
    border-block-end: 1px solid transparent;
  }

  header.is-scrolled {
    border-block-end-color: color-mix(in oklab, var(--border) 60%, transparent);
  }

  topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 50rem;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block: var(--space-2xs);
  }

  topbar-brand a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--font-weight-medium);
    font-size: var(--step-0);
    color: var(--foreground);
    text-decoration-line: none;

    svg {
      inline-size: 1rem;
      block-size: 1rem;
      flex-shrink: 0;
    }

    span {
      display: none;
    }
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    list-style: none;
    margin: 0;

    a {
      color: var(--muted-foreground);
      font-size: var(--step--1);
      text-decoration-line: none;

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }
  }

  topbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  #fullwidth-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;

    &:hover {
      color: var(--foreground);
      background: color-mix(in oklab, var(--muted-foreground) 10%, transparent);
    }

    svg {
      inline-size: 1rem;
      block-size: 1rem;
    }

    .collapse {
      display: none;
    }

    &.is-active {
      .expand {
        display: none;
      }
      .collapse {
        display: block;
      }
    }
  }
</style>
