---
import { SITE } from "@/consts"
import { pageTitle, type PostView } from "@/lib/content"
import { localePath, t, type Locale } from "@/lib/i18n"
import { formatDate, subpostSlug } from "@/lib/utils"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"

type ChainItem = {
  view: PostView
  /** 已翻译条目的 render() 结果；未翻译条目省略 */
  Content?: AstroComponentFactory
  authors: CollectionEntry<"authors">[]
}
type Props = { locale: Locale; currentId: string; items: ChainItem[] }

const { locale, currentId, items } = Astro.props
const isTopbar = SITE.layout === "topbar"
---

{items.map(({ view, Content, authors }, i) => (
  <article
    id={i === 0 ? undefined : subpostSlug(view.id)}
    data-url={localePath(`/blog/${view.id}`, locale)}
    data-title={pageTitle(view.data.title)}
    data-embedded={i > 0 || undefined}
    data-article-topbar={isTopbar || undefined}
  >
    {view.translated && Content ? (
      <>
        {isTopbar && view.data.image && (
          <post-banner>
            <Image
              src={view.data.image}
              alt={view.data.title}
              width={1200}
              height={630}
              priority={view.id === currentId || undefined}
            />
          </post-banner>
        )}
        <header>
          <h1>{view.data.title}</h1>
          {view.en?.data.aiTranslated && (
            <ai-translated-badge>{t(locale, "aiTranslated")}</ai-translated-badge>
          )}
          <post-meta>
            {authors.length > 0 && (
              <post-authors>
                <author-avatars>
                  {authors.map((author) => (
                    <img
                      src={author.data.avatar}
                      alt={author.data.name}
                      width="18"
                      height="18"
                    />
                  ))}
                </author-avatars>
                <author-names>
                  {authors.map((author, j) => (
                    <>{j > 0 && ", "}<a href={`/authors/${author.id}`}>{author.data.name}</a></>
                  ))}
                </author-names>
              </post-authors>
            )}
            <time datetime={view.data.date.toISOString()}
              >{formatDate(view.data.date, locale)}</time
            >
            {view.data.tags && (
              <post-tags>
                {view.data.tags.map((tag) => (
                  <a href={`/tags/${tag}`}>#{tag}</a>
                ))}
              </post-tags>
            )}
          </post-meta>
          <p>{view.data.description}</p>
        </header>
        {!isTopbar && view.data.image && (
          <post-banner>
            <Image
              src={view.data.image}
              alt={view.data.title}
              width={1200}
              height={630}
              priority={view.id === currentId || undefined}
            />
          </post-banner>
        )}
        <prose-content>
          <Content />
        </prose-content>
      </>
    ) : (
      <untranslated-section data-untranslated>
        <header>
          <h1>{view.data.title}</h1>
        </header>
        <p>{t(locale, "sectionUntranslated")}</p>
        <a href={`/blog/${view.id}`}>{t(locale, "readOriginal")}</a>
      </untranslated-section>
    )}
  </article>
))}

<style>
  article[data-embedded] {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);
    scroll-margin-block-start: calc(-2px - 0.2 * var(--step-2));

    header h1 {
      font-size: var(--step-2);
    }
  }

  header {
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    ai-translated-badge {
      display: inline-block;
      margin-block-start: var(--space-3xs);
      padding-inline: var(--space-2xs);
      font-size: var(--step--1);
      line-height: 1.5;
      color: var(--muted-foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
      border-radius: var(--radius-full);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-tags {
        --underline: transparent;

        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        a {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

          &:hover {
            color: var(--foreground);
          }
        }
      }

      time ~ post-tags::before {
        content: "·";
      }

      a {
        color: var(--foreground);
      }
    }

    > p {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
    }
  }

  untranslated-section {
    display: block;
    padding: var(--space-m);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--muted-foreground);

    p {
      margin-block-start: var(--space-2xs);
    }

    a {
      display: inline-block;
      margin-block-start: var(--space-2xs);
      color: var(--foreground);
    }
  }

  [data-article-topbar] {
    header {
      text-align: center;

      post-meta {
        justify-content: center;
      }
    }

    post-banner {
      margin-block-end: var(--space-m);
    }

    prose-content,
    untranslated-section {
      display: block;
      max-width: var(--measure);
      margin-inline: auto;
    }
  }

  html[data-fullwidth] [data-article-topbar] prose-content {
    max-width: 100%;
  }
</style>
