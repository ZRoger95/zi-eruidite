---
import type { PostView } from "@/lib/content"
import { localeFromPath, localePath, t } from "@/lib/i18n"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Props = { post: CollectionEntry<"blog"> | PostView }

const { post } = Astro.props
const view: PostView =
  "translated" in post
    ? post
    : { id: post.id, data: post.data, translated: true, zh: post }

const locale = localeFromPath(Astro.url.pathname)
const href = localePath(`/blog/${view.id}`, locale)
const authors = await getEntries(view.data.authors)
---

<li>
  {view.data.image && (
      <a href={href} tabindex="-1" aria-hidden="true">
        <Image src={view.data.image} alt="" width={640} height={336} />
      </a>
    )}
  <entry-info>
    <entry-head>
      <a href={href}>{view.data.title}</a>
      {!view.translated && (
        <entry-badge>{t(locale, "untranslatedBadge")}</entry-badge>
      )}
    </entry-head>
    <entry-meta>
      {authors.length > 0 && (
          <entry-authors>
            <author-avatars>
              {authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}{author.data.name}</>
              ))}
            </author-names>
          </entry-authors>
        )}
      <time datetime={view.data.date.toISOString()}
        >{formatDate(view.data.date, locale)}</time
      >
      {view.data.tags && (
          <entry-tags>
            {view.data.tags.map((tag) => (
              <a href={`/tags/${tag}`}>#{tag}</a>
            ))}
          </entry-tags>
        )}
    </entry-meta>
    <p>{view.data.description}</p>
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      entry-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-3xs) var(--space-2xs);

        > a {
          font-size: var(--step-1);
          line-height: calc(var(--leading-offset) + 1em);
          font-weight: var(--font-weight-medium);
        }

        entry-badge {
          flex-shrink: 0;
          padding-inline: var(--space-2xs);
          font-size: var(--step--1);
          line-height: 1.5;
          white-space: nowrap;
          color: var(--muted-foreground);
          background-color: color-mix(in oklab, var(--muted) 50%, transparent);
          border-radius: var(--radius-full);
        }
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);

          author-avatars {
            display: flex;
            margin-block-end: -0.1em;

            img {
              border-radius: var(--radius-full);
              box-shadow: 0 0 0 1.5px var(--background);

              &:not(:first-child) {
                margin-inline-start: -0.375rem;
              }
            }
          }
        }

        entry-authors ~ time::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }

        entry-tags {
          display: flex;
          flex-wrap: wrap;
          gap: var(--space-3xs);

          span {
            color: color-mix(
              in oklab,
              var(--muted-foreground) 50%,
              transparent
            );
          }
        }

        time ~ entry-tags::before {
          content: "·";
        }
      }

      p {
        color: var(--muted-foreground);
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
