---
import ArrowLeft from "@/assets/icons/arrow-left.svg"
import ArrowRight from "@/assets/icons/arrow-right.svg"
import ScrollToTop from "@/components/ScrollToTop.astro"
import type { PostView } from "@/lib/content"
import { localeFromPath, localePath, t } from "@/lib/i18n"
import type { CollectionEntry } from "astro:content"

/** zh 文章页传 CollectionEntry，en 文章页传 PostView（id 均为 baseId）。 */
type PostLike = CollectionEntry<"blog"> | PostView
type Props = { prev?: PostLike; next?: PostLike }

const { prev, next } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const postHref = (post?: PostLike) =>
  post && localePath(`/blog/${post.id}`, locale)
---

<post-actions>
  <a
    href={postHref(prev)}
    data-icon-button
    data-dir="prev"
    aria-label={prev && `${t(locale, "prevPost")}: ${prev.data.title}`}
    aria-hidden={!prev || undefined}
    title={prev && `${t(locale, "prevPost")}: ${prev.data.title}`}
  >
    <ArrowLeft />
  </a>
  <a
    href={postHref(next)}
    data-icon-button
    data-dir="next"
    aria-label={next && `${t(locale, "nextPost")}: ${next.data.title}`}
    aria-hidden={!next || undefined}
    title={next && `${t(locale, "nextPost")}: ${next.data.title}`}
  >
    <ArrowRight />
  </a>
  <ScrollToTop />
</post-actions>

<style>
  post-actions {
    display: contents;

    @media (width < 64rem) {
      display: none;
    }
  }

  a {
    color: var(--foreground);

    &:not([href]) {
      color: var(--muted-foreground);
      opacity: 0.5;
      pointer-events: none;
    }
  }
</style>
