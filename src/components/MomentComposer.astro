---
import { MAX_MOMENT_LENGTH } from "@/lib/moment-composer"

if (import.meta.env.PROD) return
---

<form class="compose-bar" data-moment-composer>
  <div class="compose-field">
    <textarea
      class="compose-input"
      placeholder="分享你的想法…"
      rows="1"
      maxlength={MAX_MOMENT_LENGTH}
      aria-label="动态内容"
    ></textarea>
    <p class="compose-status" role="status" aria-live="polite"></p>
  </div>
  <div class="compose-actions">
    <span class="compose-hint">⌘⏎ 发布</span>
    <button class="compose-submit" type="submit" disabled>发布</button>
  </div>
</form>

<script>
  ;(() => {
    const form = document.querySelector<HTMLFormElement>(
      "[data-moment-composer]",
    )
    if (!form) return

    const textarea = form.querySelector<HTMLTextAreaElement>(".compose-input")!
    const submit = form.querySelector<HTMLButtonElement>(".compose-submit")!
    const status = form.querySelector<HTMLElement>(".compose-status")!
    const hint = form.querySelector<HTMLElement>(".compose-hint")!

    // 非 macOS 平台改用 Ctrl 提示
    if (!/Mac|iPhone|iPad|iPod/.test(navigator.platform)) {
      hint.textContent = "Ctrl⏎ 发布"
    }

    function autoGrow() {
      textarea.style.height = "auto"
      textarea.style.height = `${textarea.scrollHeight}px`
    }

    function syncState() {
      submit.disabled = textarea.value.trim() === ""
    }

    textarea.addEventListener("input", () => {
      autoGrow()
      syncState()
    })

    textarea.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === "Enter") {
        event.preventDefault()
        form.requestSubmit()
      }
    })

    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      const content = textarea.value.trim()
      if (!content) return

      submit.disabled = true
      status.textContent = "发布中…"
      try {
        const response = await fetch("/api/moments", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ content }),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) {
          throw new Error(data.error || "发布失败")
        }
        textarea.value = ""
        autoGrow()
        status.innerHTML = `已发布 · <a href="/moments/${data.id}">查看</a>`
        // 兜底刷新；dev 下服务器会先发送 full-reload
        setTimeout(() => location.reload(), 1500)
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : "发布失败"
        submit.disabled = false
      }
    })
  })()
</script>

<style>
  .compose-bar {
    display: flex;
    align-items: flex-start;
    gap: var(--space-m);
    padding: var(--space-xs);
    margin-bottom: var(--space-l);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .compose-bar:focus-within {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--border));
  }

  .compose-field {
    flex: 1;
    min-width: 0;
  }

  .compose-input {
    display: block;
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--foreground);
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    min-height: 1.5em;
    padding: 0;
  }

  .compose-input:focus-visible {
    background: color-mix(in oklab, var(--muted) 45%, transparent);
    border-radius: var(--radius-sm);
  }

  .compose-input::placeholder {
    color: var(--muted-foreground);
  }

  .compose-actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    flex-shrink: 0;
  }

  .compose-hint {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .compose-submit {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 510;
    letter-spacing: 0.02em;
    padding: var(--space-3xs) var(--space-s);
    border-radius: var(--radius-full);
    border: none;
    background: var(--accent);
    color: var(--accent-foreground);
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .compose-submit:hover:not(:disabled) {
    opacity: 0.9;
  }

  .compose-submit:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .compose-status {
    font-size: var(--step--1);
    color: var(--muted-foreground);
    margin-top: var(--space-xs);
    min-height: 1.2em;
  }

  .compose-status a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (width < 480px) {
    .compose-bar {
      flex-wrap: wrap;
    }
  }
</style>
