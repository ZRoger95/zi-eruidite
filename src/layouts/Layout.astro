---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import "@/styles/home.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"

import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import SiteBar from "@/components/SiteBar.astro"
import { SITE } from "@/consts"
import type { BackgroundStyle } from "@/consts"
import { localeFromPath, SITE_META, t } from "@/lib/i18n"

type Props = {
  crumbs?: { label: string; href: string }[]
  /** Blog article pages use a wider content column (article header display). */
  article?: boolean
}

const { crumbs, article } = Astro.props
const locale = localeFromPath(Astro.url.pathname)

// Compute background CSS custom properties
const bg = SITE.background
const bgImage = bg?.image ? `url(${bg.image})` : undefined
const bgColor = bg?.color
const hasBackground = !!(bgImage || bgColor)
const bgStyle: BackgroundStyle = bg?.style ?? "cover"
const bgOpacity = bg?.opacity ?? 1
const bgSize = bgStyle === "tile" ? "auto" : bgStyle
const bgRepeat = bgStyle === "tile" ? "repeat" : "no-repeat"
---

<html
  lang={SITE_META[locale].htmlLang}
  dir={SITE.dir}
  data-layout={SITE.layout}
>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body
    style={hasBackground ? Object.assign({
      "--bg-image": bgImage ?? "none",
      "--bg-color": bgColor ?? "transparent",
      "--bg-size": bgSize,
      "--bg-repeat": bgRepeat,
      "--bg-opacity": String(bgOpacity),
    }) : undefined}
  >
    <a class="skip-link" href="#main-content">{t(locale, "skipLink")}</a>
    <page-shell data-article={article || undefined}>
      <page-nav>
        <SiteBar crumbs={crumbs}
          ><slot name="actions" slot="actions" /></SiteBar
        >
      </page-nav>
      <page-scroll>
        {Astro.slots.has("toc") && (
          <page-toc><slot name="toc" /></page-toc>
        )}
        <main id="main-content" tabindex="-1"><slot /></main>
        <page-footer><Footer /></page-footer>
      </page-scroll>
    </page-shell>
    <script is:inline>
      // 首帧对齐校准：容器态测滚动条宽度写 --scrollbar-width（非容器态跳过，
      // CSS 回退值 0 即无补偿）；需解析期同步执行，故纯 JS、不可 import。
      ;(() => {
        const el = document.querySelector("page-scroll")
        if (!el) return
        const style = getComputedStyle(el)
        if (style.display === "contents" || style.overflowY !== "auto") return
        document.documentElement.style.setProperty(
          "--scrollbar-width",
          el.offsetWidth - el.clientWidth + "px",
        )
      })()
    </script>
  </body>
</html>

<script>
  import { initScroll } from "@/lib/scroll"

  initScroll()
</script>

<style>
  /* 默认不产生盒子：sidebar 与移动端布局语义零变化 */
  page-scroll {
    display: contents;
  }

  main:focus {
    outline: none; /* skip-link 跳转的可见反馈由滚动/视口变化承担 */
  }

  .skip-link {
    position: fixed;
    top: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: 100;
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-sm);
    background: var(--background);
    color: var(--accent);
    border: 1px solid var(--border);
    font-size: var(--step--1);
    text-decoration: none;
    transform: translateY(calc(-100% - var(--space-2xs)));
    transition: transform 0.15s;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* ---------- 侧栏模式：原 page-grid / page-content 的网格化重构 ---------- */
  :root[data-layout="sidebar"] page-shell {
    position: relative;
    isolation: isolate;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    /* 原 gap: var(--grid-gutter)；行间距改由元素 margin 精确还原（保真） */
    column-gap: var(--grid-gutter);
    row-gap: 0;
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);
    grid-template-rows: 1fr auto;

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr auto;
      padding-block-start: 0;
    }
  }

  :root[data-layout="sidebar"] page-nav {
    display: block;
    min-width: 0;
    grid-column: 1 / 3;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      width: calc(2 * var(--grid-column-width) + var(--grid-gutter));
    }

    /* 原 page-header 的 <64rem 吸顶职责（全出血负 margin） */
    @media (width < 64rem) {
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      margin-inline: calc(-1 * var(--grid-gutter));
      margin-block-end: var(--grid-gutter);
    }
  }

  :root[data-layout="sidebar"] page-toc {
    display: block;
    min-width: 0;
    grid-column: 10 / 13;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-end: var(--grid-edge);
      width: calc(3 * var(--grid-column-width) + 2 * var(--grid-gutter));
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: 2;
      position: sticky;
      top: var(--bar-nav-height);
      z-index: 9;
      margin-inline: calc(-1 * var(--grid-gutter));
      /* 紧贴导航条（抵消 page-nav 的下间距），条下保留原 header→内容 的栅格间距 */
      margin-block-start: calc(-1 * var(--grid-gutter));
      margin-block-end: var(--grid-gutter);
    }
  }

  :root[data-layout="sidebar"] main {
    min-width: 0;
    grid-column: 3 / 10;
    grid-row: 1;
    margin-block-start: -0.1em;

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: 3;
      inline-size: 100%;
      max-inline-size: var(--measure);
      margin-inline: auto;
    }
  }

  :root[data-layout="sidebar"] page-footer {
    display: block;
    grid-column: 3 / 10;
    grid-row: 2;
    margin-block-start: var(--space-xl);

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: 4;
      inline-size: 100%;
      max-inline-size: var(--measure);
      margin-inline: auto;
    }
  }

  /* ---------- 顶栏模式：原 page-content-topbar 的网格化重构 ---------- */
  :root[data-layout="topbar"] page-shell {
    --topbar-measure: 50rem;
    /* 内容列左缘：原 page-content-topbar 居中后内容盒的左右缩进
       （= max(gutter, (100% − measure) / 2 + gutter)） */
    --topbar-edge: max(
      var(--grid-gutter),
      (100% - var(--topbar-measure)) /
      2 +
      var(--grid-gutter)
    );
    position: relative;
    z-index: 1;

    /* <64rem：沿用原 page-content-topbar 的 flex 列语义（子项外边距不折叠） */
    @media (width < 64rem) {
      display: flex;
      flex-direction: column;
    }
  }

  /* ---------- 容器模式（topbar ≥64rem）：顶栏固定行 + 内容行独立滚动 ---------- */
  @media (width >= 64rem) {
    /* 页面级滚动收进容器：root 不再滚动、gutter 交给 page-scroll（layout.css） */
    :root[data-layout="topbar"] {
      overflow: hidden;
    }

    :root[data-layout="topbar"] body {
      overflow: hidden;
    }

    :root[data-layout="topbar"] page-shell {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      height: 100svh;
      overflow: hidden;
    }

    :root[data-layout="topbar"] page-scroll {
      display: grid;
      /* 原 page-shell 顶栏列定义逐字迁移（列宽公式不变） */
      grid-template-columns:
        minmax(var(--grid-gutter), 1fr)
        14rem
        minmax(
          0,
          calc(
            min(var(--topbar-measure), 100%) -
            2 *
            var(--grid-gutter) -
            14rem -
            var(--space-l)
          )
        )
        minmax(var(--grid-gutter), 1fr);
      column-gap: var(--space-l);
      overflow-y: auto;
      scrollbar-gutter: stable;
      min-height: 0;
      /* 内容短于容器时（如 404）两行不被多余空间拉伸：
         main 不拉高、页脚随内容流，与基线短页行为一致 */
      align-content: start;
    }
  }

  /* 原 page-content-topbar[data-article]：≥64rem 用 80rem 内容列；
     <64rem 由基础值 50rem 自然回落（与原 @media 内 50rem 回落同义） */
  @media (width >= 64rem) {
    :root[data-layout="topbar"] page-shell[data-article] {
      --topbar-measure: 80rem;
    }
  }

  /* 原 html[data-fullwidth] 规则：两种断点下均优先于文章加宽 */
  :root[data-layout="topbar"][data-fullwidth] page-shell[data-article] {
    --topbar-measure: 100%;
  }

  /* site-bar 直接作为网格第 1 行（page-nav 不产生盒子） */
  :root[data-layout="topbar"] page-nav {
    display: contents;
  }

  :root[data-layout="topbar"] main {
    min-width: 0;
    margin-block-start: var(--space-xl);

    @media (width >= 64rem) {
      grid-column: 2 / 4;
      grid-row: 1;
    }

    @media (width < 64rem) {
      /* 复刻原 flex 列语义：main 为 fit-content（available = 100% − 2×edge），
         左右缘对齐内容列（旧 topbar-article 为 align-items: flex-start 的 flex 列） */
      width: fit-content;
      margin-inline: var(--topbar-edge);
    }
  }

  :root[data-layout="topbar"] page-scroll:has(> page-toc) main {
    @media (width >= 64rem) {
      grid-column: 3;
    }

    @media (width < 64rem) {
      margin-block-start: var(--space-l);
    }
  }

  :root[data-layout="topbar"] page-toc {
    display: block;
    margin-block-start: var(--space-xl);

    /* 容器模式：本元素退为普通网格项（拉伸占满行高，使 nav 的 sticky 在
       容器滚动域内可停靠）；停靠偏移与 max-height 由 nav 承担，见
       TableOfContents.astro 容器分支。 */
    @media (width >= 64rem) {
      grid-column: 2;
      grid-row: 1;
      width: 14rem;
    }

    @media (width < 64rem) {
      position: static;
      max-height: none;
      overflow: visible;
      /* 原 <64rem 的 page-toc 为 width: 100%：拉伸至内容列（100% − 2×edge） */
      margin-inline: var(--topbar-edge);
      /* 与 main 的间距由 main 的 margin-block-start: var(--space-l) 承担（flex 下不折叠） */
    }
  }

  :root[data-layout="topbar"] page-footer {
    display: block;
    margin-block-start: var(--space-xl);

    @media (width >= 64rem) {
      grid-column: 2 / 4;
      grid-row: 2;
    }

    @media (width < 64rem) {
      /* 原页面页脚为块级满宽：拉伸至内容列（100% − 2×edge） */
      margin-inline: var(--topbar-edge);
    }
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--bg-image);
    background-color: var(--bg-color);
    background-size: var(--bg-size);
    background-repeat: var(--bg-repeat);
    background-position: center;
    opacity: var(--bg-opacity);
  }
</style>
